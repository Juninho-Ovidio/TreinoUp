# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública do app (usada nos links de e-mail de confirmação e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só para desenvolvimento: libera os recursos Premium para todos os usuários
NEXT_PUBLIC_ALL_PREMIUM=false

# Só para o script de importação de alimentos (NUNCA exponha no front-end)
SUPABASE_SERVICE_ROLE_KEY=

# Só para o script de vídeos dos exercícios (gerar:videos). Chave da API Gemini/Veo.
GEMINI_API_KEY=
