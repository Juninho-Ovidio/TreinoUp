# O MESMO projeto Supabase do TreinoUp web (um login só para o app inteiro).
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...). Nunca a service role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Botões de login social. Ligue só depois de configurar o provedor no Supabase
# (Authentication → Providers). Apple usa o login nativo no iOS e o web nos demais.
EXPO_PUBLIC_AUTH_GOOGLE=false
EXPO_PUBLIC_AUTH_APPLE=false

# Opcional: id do projeto no EAS (gerado por `npx eas-cli@latest init`).
EAS_PROJECT_ID=

# Opcional: estilos do mapa (padrão: OpenFreeMap, grátis e sem chave).
# Ex.: MapTiler com chave → https://api.maptiler.com/maps/streets-v2/style.json?key=SUA_CHAVE
EXPO_PUBLIC_MAP_STYLE_LIGHT=
EXPO_PUBLIC_MAP_STYLE_DARK=
